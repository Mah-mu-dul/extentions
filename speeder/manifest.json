{
  "manifest_version": 3,
  "name": "Video Speed Controller for JW Player",
  "version": "1.0",
  "description": "Adds a speed control slider to JW Player videos.",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JW Video Speed"
  }
}
